    "# =============================================================================\n",
    "# PART 1: QUANTUM EMBEDDING\n",
    "# =============================================================================\n",
    "\n",
    "from qiskit import QuantumCircuit\n",
    "from qiskit.quantum_info import Statevector\n",
    "import numpy as np\n",
    "\n",
    "print(\"⚛️🔄 Quantum Data Embedding...\")\n",
    "\n",
    "def angle_encode(data, n_qubits=4):\n",
    "    \"\"\"Angle encoding: encode classical data as quantum angles\"\"\"\n",
    "    qc = QuantumCircuit(n_qubits)\n",
    "    \n",
    "    for i, val in enumerate(data[:n_qubits]):\n",
    "        qc.ry(val * np.pi, i)  # Rotation proportional to data\n",
    "    \n",
    "    return qc\n",
    "\n",
    "# Encode sample data\n",
    "data = np.array([0.5, 0.2, 0.8, 0.1])\n",
    "qc = angle_encode(data)\n",
    "\n",
    "print(\"📐 Encoded Circuit:\")\n",
    "print(qc.draw())\n",
    "\n",
    "# Get quantum state\n",
    "sv = Statevector.from_int(0, 16)  # 4 qubits = 16 dims\n",
    "sv = sv.evolve(qc)\n",
    "\n",
    "print(\"\\n📊 Quantum State:\")\n",
    "print(f\"   Amplitudes: {sv.data[:8].round(4)}\")  # First 8"
   ]
