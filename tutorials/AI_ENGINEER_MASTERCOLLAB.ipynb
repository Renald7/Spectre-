    "# =============================================================================\n",
    "# PART 3: K-NEAREST NEIGHBORS (KNN)\n",
    "# =============================================================================\n",
    "\n",
    "import numpy as np\n",
    "from collections import Counter\n",
    "\n",
    "class KNN:\n",
    "    \"\"\"K-Nearest Neighbors Classifier\"\"\"\n",
    "    \n",
    "    def __init__(self, k=3):\n",
    "        self.k = k\n",
    "        self.X_train = None\n",
    "        self.y_train = None\n",
    "    \n",
    "    def fit(self, X, y):\n",
    "        \"\"\"Store training data\"\"\"\n",
    "        self.X_train = X\n",
    "        self.y_train = y\n",
    "    \n",
    "    def predict(self, X):\n",
    "        \"\"\"Predict classes for samples\"\"\"\n",
    "        predictions = []\n",
    "        for x in X:\n",
    "            # Calculate distances\n",
    "            distances = np.sqrt(np.sum((self.X_train - x)**2, axis=1))\n",
    "            \n",
    "            # Get k nearest\n",
    "            k_indices = np.argsort(distances)[:self.k]\n",
    "            k_labels = self.y_train[k_indices]\n",
    "            \n",
    "            # Majority vote\n",
    "            vote = Counter(k_labels).most_common(1)[0][0]\n",
    "            predictions.append(vote)\n",
    "        \n",
    "        return np.array(predictions)\n",
    "\n",
    "# Test KNN\n",
    "np.random.seed(42)\n",
    "X = np.random.randn(100, 2)\n",
    "y = np.array([0]*50 + [1]*50)\n",
    "# Add separation\n",
    "X[y==1] += 2\n",
    "\n",
    "# Train and test\n",
    "knn = KNN(k=5)\n",
    "knn.fit(X, y)\n",
    "predictions = knn.predict(X)\n",
    "print(f\"📐 KNN Results:\")\n",
    "print(f\"   K = 5\")\n",
    "print(f\"   Accuracy: {np.mean(predictions == y):.2%}\")"
   ]
