    "# =============================================================================\n",
    "# PART 2: VARIATIONAL QUANTUM CIRCUITS\n",
    "# =============================================================================\n",
    "\n",
    "from qiskit import QuantumCircuit\n",
    "from qiskit.circuit.library import EfficientSU2\n",
    "from qiskit.quantum_info import Statevector\n",
    "import numpy as np\n",
    "\n",
    "print(\"⚛️🔧 Variational Quantum Circuits...\")\n",
    "\n",
    "# Create parameterized ansatz\n",
    "ansatz = EfficientSU2(num_qubits=4, reps=2, entanglement='full')\n",
    "print(f\"📐 Ansatz: {ansatz.name}\")\n",
    "print(f\"   Parameters: {ansatz.num_parameters}\")\n",
    "\n",
    "# Create full circuit\n",
    "qc = QuantumCircuit(4)\n",
    "qc.h(range(4))  # Initial superposition\n",
    "qc = qc.compose(ansatz)\n",
    "\n",
    "print(\"\\n📐 Circuit:\")\n",
    "print(qc.draw())\n",
    "\n",
    "# Forward pass simulation\n",
    "params = np.random.uniform(0, 2*np.pi, ansatz.num_parameters)\n",
    "\n",
    "# Apply parameters\n",
    "param_qc = ansatz.assign_parameters(params)\n",
    "full_qc = QuantumCircuit(4)\n",
    "full_qc.h(range(4))\n",
    "full_qc.compose(param_qc, inplace=True)\n",
    "\n",
    "# Get statevector\n",
    "sv = Statevector.from_int(0, 16)\n",
    "sv = sv.evolve(full_qc)\n",
    "\n",
    "print(\"\\n📊 Output Probabilities:\")\n",
    "probs = sv.probabilities()\n",
    "print(f\"   Top 4 states: {np.sort(probs)[-4:][::-1].round(4)}\")"
   ]
